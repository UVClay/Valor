# Game data: never commit anything from the disc
disc/
extracted/
*.bin
*.cue
*.iso
*.chd

# Memory cards, settings, screenshots (F12) and input recordings
saves/
screenshots/
recordings/

# Build output (the container's $HOME is build/home)
build/
.cache/
gen/
__pycache__/
*.pyc
*.m2c

# The Godot host's build output and editor cache
engine/godot/project/bin/
engine/godot/project/.godot/
