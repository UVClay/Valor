[configuration]

entry_symbol = "valor_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libvalor.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libvalor.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libvalor.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libvalor.windows.template_release.x86_64.dll"
