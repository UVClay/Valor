#!/usr/bin/env bash
# Build (if needed) and play, inside the dev container, with the host's display, audio,
# GPU and controllers passed through. Extra arguments go to the runtime.
#   ./play                    uses disc/Medal of Honor (USA)/*.cue
#   ./play --disc other.cue
#   ./play --warp 3:2          New Game starts in mission 3, level 2 (testing)
#   ./play --record recordings/NAME   records your inputs (and settings and memory card)
#   ./play --replay recordings/NAME --video build/NAME.mkv   replays them (hidden) into a video:
#                              .mkv lossless (FFV1), .mp4/.webm AV1; --video-range FROM:TO limits
#                              it to those vblanks
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root"

disc=(disc/"Medal of Honor (USA)"/*.cue)
args=(--bios build/openbios/openbios.bin)
[[ " $* " == *" --disc "* ]] || args+=(--disc "${disc[0]}")

# --warp MISSION:LEVEL: the next New Game loads that level instead (see tools/warp.sh).
passthrough=()
while [ $# -gt 0 ]; do
    if [ "$1" = --warp ] && [ $# -ge 2 ]; then
        m=${2%:*} l=${2#*:}
        args+=(--poke-on-call "80064374:80038660=$((m - 1))" --poke-on-call "80064374:80038664=$((l - 1))")
        shift 2
    elif [ "$1" = --video ] && [ $# -ge 2 ]; then
        video=$2
        shift 2
    else
        passthrough+=("$1")
        shift
    fi
done
set -- "${passthrough[@]+"${passthrough[@]}"}"

./dev bash -c 'cmake -S . -B build/cmake -G Ninja >/dev/null && cmake --build build/cmake | grep -vE "^\[" || true'

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
gui=(-e XDG_RUNTIME_DIR=/tmp/runtime)
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime/$WAYLAND_DISPLAY" ]; then
    gui+=(-e WAYLAND_DISPLAY -v "$runtime/$WAYLAND_DISPLAY:/tmp/runtime/$WAYLAND_DISPLAY")
fi
if [ -n "${DISPLAY:-}" ] && [ -d /tmp/.X11-unix ]; then
    gui+=(-e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix)
fi
[ -S "$runtime/pipewire-0" ] && gui+=(-v "$runtime/pipewire-0:/tmp/runtime/pipewire-0")
[ -d "$runtime/pulse" ] && gui+=(-v "$runtime/pulse:/tmp/runtime/pulse")
[ -d /dev/dri ] && gui+=(--device /dev/dri)
# Controllers: the whole input directory so hot-plugged pads show up, plus udev for discovery.
gui+=(-v /dev/input:/dev/input -v /run/udev:/run/udev:ro --group-add keep-groups)

# Local time (debug sessions are named by it).
[ -e /etc/localtime ] && gui+=(-v /etc/localtime:/etc/localtime:ro)

# Debug switches (VALOR_TRACE_*, ...) reach the runtime inside the container.
for var in $(compgen -e | grep '^VALOR_' || true); do gui+=(-e "$var"); done

tty_flags=()
[ -t 0 ] && tty_flags=(-it)

# --video FILE: the runtime streams the replay's frames (YUV4MPEG2) through a pipe into the host's
# ffmpeg (the container has none).
if [ -n "${video:-}" ]; then
    command -v ffmpeg >/dev/null || { echo "--video needs ffmpeg on the host" >&2; exit 1; }
    case "$video" in
        *.mkv) codec=(-c:v ffv1 -level 3 -slices 16) ;;
        *) codec=(-c:v libsvtav1 -preset 8 -crf 18 -pix_fmt yuv420p) ;;
    esac
    fifo=build/video.fifo
    rm -f "$fifo"
    mkfifo "$fifo"
    ffmpeg -y -hide_banner -loglevel error -f yuv4mpegpipe -i "$fifo" "${codec[@]}" "$video" &
    encoder=$!
    image="moh-recomp-dev:$(cat Containerfile requirements.txt | sha256sum | cut -c1-12)"
    status=0
    podman run --rm --userns=keep-id --security-opt label=disable \
        -v "$root:/work" -w /work -e HOME=/work/build/home "${gui[@]}" "$image" ./build/cmake/valor "${args[@]}" \
        --video "$fifo" "$@" || status=$?
    exec 3<>"$fifo"  # if the runtime never opened it, ffmpeg still sees the end (doesn't block)
    exec 3>&-
    wait "$encoder" || true
    rm -f "$fifo"
    echo "video: $video"
    exit $status
fi

image="moh-recomp-dev:$(cat Containerfile requirements.txt | sha256sum | cut -c1-12)"
exec podman run --rm "${tty_flags[@]}" --userns=keep-id --security-opt label=disable \
    -v "$root:/work" -w /work -e HOME=/work/build/home "${gui[@]}" "$image" ./build/cmake/valor "${args[@]}" "$@"
